#!/usr/bin/env python3
"""gen_skills — erzeugt aus repos.tsv + vendor/ die Skill-Karten, MANIFEST.yaml und INDEX.md."""
import json
import os
import re
import shutil
import sys
import time

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
from repos_tsv import RepoTableError, load, tree_digest  # noqa: E402
from tool_matrix import LIB, PROBE, REF  # noqa: E402

HOME = os.path.expanduser("~")
ROOT = os.path.join(HOME, "ctf-skills")
VENDOR = os.path.join(ROOT, "vendor")
KN = os.path.join(ROOT, "knowledge")

KIND = {"PY": "tool", "RS": "tool", "GO": "tool", "JS": "tool", "DK": "docker",
        "DOC": "knowledge", "DATA": "corpus", "SRC": "source", "ARCH": "knowledge"}
INSTALL = {"PY": "uv tool", "RS": "release-binary", "GO": "release-binary", "JS": "npm -g",
           "DK": "docker (auf dieser Maschine nicht verfuegbar)", "DOC": "keine Installation",
           "DATA": "keine Installation", "SRC": "keine Installation (Quell-Referenz)",
           "ARCH": "keine Installation (archiviert, Wissen only)"}
CLASS_BLIND = {
    "PY": "Findings sind Hypothesen; kein Beweis ohne Gegenbeispiel oder Pfad.",
    "RS": "schnelle Breite, aber ohne Invarianten findet der Fuzzer nichts.",
    "GO": "wie RS: Qualitaet der Properties entscheidet, nicht die Worker-Zahl.",
    "JS": "JS-Werkzeuge sehen nur, was sie parsen; Build-/Deploy-Kontext fehlt oft.",
    "DK": "braucht Docker; auf dieser Maschine nicht lauffaehig -> nur Referenz.",
    "DOC": "kein ausfuehrbares Artefakt; Wissen muss aktiv auf das Ziel abgebildet werden.",
    "DATA": "Datenmenge ohne Semantik: Muster erkennen, nicht blind uebernehmen.",
    "SRC": "kein fertiges Werkzeug; Referenz zum Nachschlagen von Semantik.",
    "ARCH": "Original ist archiviert/ueberholt: Regeln und Ideen nutzen, nicht betreiben.",
}
LAYER_WHEN = {
    "L0": "immer zuerst: Scope, Rechte, Meldeweg klaeren",
    "L1": "sobald Quellcode/Bytecode vorliegt: Karte bauen, Compiler pinnen",
    "L2": "Breite zuerst: alle In-Scope-Artefakte statisch abklopfen",
    "L3": "wenn eine Annahme pruefbar wird: Invariante formulieren und brechen lassen",
    "L4": "wenn ein statischer Treffer einen konkreten Pfad braucht",
    "L5": "wenn kein Quellcode existiert (Bytecode-only, Proxy, fremdes Deployment)",
    "L6": "wenn sich Code/Parameter geaendert haben (Upgrade, Deployment, Fork)",
    "L7": "wenn Geld, Reihenfolge, Inclusion oder Vertrauen im Spiel ist",
    "L8": "durchgehend: Musterabgleich gegen bekannte Bug-Klassen und Audit-Erfahrung",
    "L9": "sobald ein Fund existiert: beweisen, melden, eskalieren",
}
LAYER_BLIND = {
    "L0": "sagt nichts ueber Code.", "L1": "kennt die Absicht des Autors nicht.",
    "L2": "sieht zeitliche, oekonomische und Cross-Contract-Fehler nicht.",
    "L3": "findet nur, wofuer jemand eine Invariante formuliert hat.",
    "L4": "Pfad-Explosion, Loops und Hash-/Krypto-Logik brechen es.",
    "L5": "Off-Chain-Verhalten und Deployment-Kontext fehlen.",
    "L6": "findet keine Altlasten, die schon immer da waren.",
    "L7": "sagt nichts ueber Code-Korrektheit.", "L8": "Aktualitaet und projektspezifische Besonderheit.",
    "L9": "ist kein Analysewerkzeug.",
}
PAIRS = {
    "L0": ["safe-harbor", "seal-frameworks", "drill-template"],
    "L1": ["crytic-compile", "solc-select", "surya", "solar"],
    "L2": ["slither", "surya", "bytecode-verifier", "slither-mcp"],
    "L3": ["echidna", "medusa", "properties", "scribble", "diligence-fuzzing"],
    "L4": ["mythril", "manticore"],
    "L5": ["evm-cfg-builder", "pyevmasm", "etheno", "abi-guesser", "canonical-signatures"],
    "L6": ["diffusc", "oz-upgrades", "chainsecurity-deployment-validation", "bytecode-verifier"],
    "L7": ["cryo", "mev-inspect-py", "transaction-decoder", "rbuilder"],
    "L8": ["not-so-smart-contracts", "smart-contract-best-practices", "slowmist-knowledge-base", "ethernaut"],
    "L9": ["seal-911", "seal-frameworks", "blockchain-security-contacts"],
}
NEXT = {"L0": "L1", "L1": "L2", "L2": "L3", "L3": "L4", "L4": "L5", "L5": "L6", "L6": "L7", "L7": "L8", "L8": "L9", "L9": "L2"}
LOCAL_STATE = {
    "cryo": "**Laeuft** (Selbstbau, kein Release-Asset vorhanden). Rezept: `recipes/cryo-build.sh`. "
            "Binary: `tools/cryo/bin/cryo`. Aufruf: `cryo help` bzw. `cryo blocks --blocks 19000000:19000000 -r <rpc>`.",
    "diffusc": "**Laeuft** (kein git noetig). Rezept: `recipes/diffusc-setup.sh` (Slither-Fork als Tarball + 2 Patches: "
               "pkg_resources.require, solc_select-User-Agent). Binary: `~/.local/bin/diffusc`. "
               "Aufruf: `diffusc VaultV1.sol VaultV2.sol -d out/` — Dateiname bestimmt den Contract-Namen (VaultV1 -> Vault), "
               "`forge` muss im PATH sein.",
    "daedaluzz": "**Laeuft** (Go, nicht Python). Rezept: `recipes/daedaluzz-build.sh` (Go 1.23.4 nach `~/.local/opt`). "
                 "Binary: `~/.local/bin/daedaluzz`. Aufruf: `daedaluzz` im Zielverzeichnis -> schreibt `generated-maze.sol`.",
}
STOP = set("the and for with your from that this use how what are you can not docs github com http https www readme".split())


def headings(path):
    out = []
    try:
        with open(path, errors="ignore") as fh:
            for i, line in enumerate(fh):
                if i > 400:
                    break
                m = re.match(r"^(#{1,3})\s+(.{2,90})$", line.rstrip())
                if m:
                    t = re.sub(r"[`*_\[\]()#>|]", "", m.group(2)).strip()
                    if t and t.lower() not in ("readme", "table of contents", "contents"):
                        out.append(t)
    except OSError:
        pass
    seen, res = set(), []
    for h in out:
        k = h.lower()
        if k not in seen:
            seen.add(k)
            res.append(h)
    return res[:16]


def triggers(slug, heads, cls, layer):
    words = []
    for h in heads:
        for w in re.split(r"[^\w\-\+\.]+", h.lower()):
            w = w.strip("-.")
            if len(w) > 3 and w not in STOP and not w.isdigit() and w not in words:
                words.append(w)
    for w in re.split(r"[-_]", slug):
        if len(w) > 3 and w not in words:
            words.append(w)
    words.append(layer)
    return words[:26]


def yaml_list(items, indent):
    pad = " " * indent
    return "".join(f"{pad}- {json.dumps(i)}\n" for i in items)


def entry_status(slug, vendor, cls, kind):
    """Gemessene Einordnung aus derselben Tabelle, die `bin/doctor` ausfuehrt.

    REF/LIB werden woertlich uebernommen; PROBE wird nur per `which` geprueft, damit die
    Karte keinen Start behauptet. Ein Eintrag ohne Tabellenzugehoerigkeit ist
    `unklassifiziert` — dieselbe Luecke meldet `bin/doctor` als FAIL.
    """
    if cls == "ARCH":
        return "referenz", "archiviert/ueberholt — Regeln nutzen, Tool nicht betreiben"
    if cls == "DK":
        return "referenz", "braucht Docker; auf dieser Maschine nicht lauffaehig"
    if kind == "tool":
        if slug in REF:
            return "referenz", REF[slug].format(p=vendor)
        if slug in LIB:
            return "bibliothek", "installiert; Nutzung als Modul, kein CLI"
        if slug in PROBE:
            binary = PROBE[slug]
            if shutil.which(binary):
                return "binary", "`%s` im PATH" % binary
            return "binary-fehlt", "`%s` nicht im PATH — bin/doctor meldet das als FAIL" % binary
        return "unklassifiziert", "kein Eintrag in PROBE/LIB/REF (bin/doctor: FAIL)"
    return {"knowledge": ("wissen", "Text und Regeln, kein Betrieb"),
            "corpus": ("korpus", "Daten/Korpus, kein CLI"),
            "source": ("quelle", "Quellbaum als Semantik-Referenz"),
            "docker": ("referenz", "braucht Docker"),
            }.get(kind, ("unklassifiziert", ""))


def main():
    try:
        rows, aliases = load(os.path.join(ROOT, "repos.tsv"))
    except RepoTableError as exc:
        raise SystemExit("repos.tsv: %s" % exc)
    by_slug = {r["slug"]: r for r in rows}
    alias_by_target = {}
    for a in aliases:
        alias_by_target.setdefault(a["target"], []).append(a)
    # Der Pin muss zum aktuellen Baum passen, sonst waere die Karte eine Behauptung.
    for target, records in alias_by_target.items():
        tree = os.path.join(VENDOR, *by_slug[target]["repo"].split("/"))
        try:
            digest, files = tree_digest(tree)
        except RepoTableError as exc:
            raise SystemExit("Alias-Beweis fuer %s nicht pruefbar: %s" % (target, exc))
        for a in records:
            if (digest, files) != (a["tree_sha256"], a["files"]):
                raise SystemExit(
                    "Alias-Beweis veraltet: %s -> %s (Baum %s/%d, gepinnt %s/%d). "
                    "Pruefen und neu pinnen: bin/alias-check --update"
                    % (a["slug"], target, digest[:12], files,
                       a["tree_sha256"][:12], a["files"]))
    entries, cards = [], 0
    for r in rows:
        slug, repo, cls, layer, role = r["slug"], r["repo"], r["cls"], r["layer"], r["role"]
        org, name = repo.split("/", 1)
        vdir = os.path.join(VENDOR, org, name)
        meta = {}
        mf = os.path.join(vdir, ".fetched")
        if os.path.exists(mf):
            try:
                meta = json.load(open(mf))
            except json.JSONDecodeError:
                meta = {}
        installed = bool(meta)
        heads = headings(os.path.join(vdir, "README.md"))
        trig = triggers(slug, heads, cls, layer)
        pairs = [p for p in PAIRS.get(layer, []) + PAIRS.get(NEXT.get(layer, ""), []) if p != slug][:8]
        kind = "knowledge-archived" if cls == "ARCH" else KIND[cls]
        status, status_reason = entry_status(slug, f"vendor/{org}/{name}", cls, kind)
        entry = {
            "slug": slug, "org": org, "repo": name, "class": cls, "kind": kind,
            "layer": layer, "role": role, "install": INSTALL[cls],
            "status": status, "status_reason": status_reason,
            "vendor": f"vendor/{org}/{name}", "fetched": installed,
            "aliases": [{"slug": a["slug"], "repo": a["repo"],
                         "tree_sha256": a["tree_sha256"], "files": a["files"]}
                        for a in alias_by_target.get(slug, [])],
            "branch": meta.get("branch"), "archived": meta.get("archived"),
            "license": meta.get("license"), "pushed_at": meta.get("pushed_at"),
            "bytes": meta.get("tarball_bytes"),
            "triggers": trig, "pairs_with": pairs,
            "blind_spots": [CLASS_BLIND[cls], LAYER_BLIND[layer]],
        }
        entries.append(entry)
        # --- Skill-Karte ---
        d = os.path.join(KN, slug)
        os.makedirs(d, exist_ok=True)
        cmds = {
            "PY": f"`{slug}` (via `uv tool`); Hilfe: `{slug} --help`",
            "RS": f"`{slug} --help` (Release-Binary in ~/.local/bin, falls vorhanden)",
            "GO": f"`{slug} --help` (Release-Binary, falls vorhanden)",
            "JS": f"`{slug} --help` (npm global)",
            "DK": "Docker erforderlich — Rezept liegt in `recipes/%s.sh`, hier nicht lauffähig" % slug,
            "DOC": "kein Kommando — Karte lesen, Regel auf das Ziel abbilden",
            "DATA": "kein Kommando — Daten indexieren, Muster abfragen",
            "SRC": "kein Kommando — Quelle bei Semantikfragen nachschlagen",
            "ARCH": "kein Kommando — Regeln/Ideen entnehmen, Tool nicht betreiben",
        }
        interpretation = {
            "PY": "Exit-Code plus Findings/Detektor-IDs. Jeder Treffer ist eine Hypothese; bestätigt wird über L3 (Counterexample) oder L4 (Pfad).",
            "RS": "Counterexample = harter Beweis. Sauberer Lauf = nur so gut wie die formulierte Invariante.",
            "GO": "Assertion-Verletzung mit Call-Sequenz; Coverage sagt, was überhaupt erreichbar war.",
            "JS": "Graph/Report als Landkarte; Aussagen über Laufzeitverhalten sind daraus nicht ableitbar.",
            "DK": "—",
            "DOC": "Text ist Muster, keine Messung: auf das Ziel abbilden und gegen Code prüfen.",
            "DATA": "Treffer sind Ähnlichkeit, kein Beweis.",
            "SRC": "Semantik-Nachschlagewerk: ‚was tut die EVM hier wirklich'.",
            "ARCH": "Historische Regeln; Detektoren können veraltet sein.",
        }
        alias_block = ""
        if entry["aliases"]:
            alias_block = "## Zweiter Remote\n" + "\n".join(
                "`{repo}` ist Alias, kein zweiter Klon: derselbe Baum "
                "(`tree_sha256` `{sha}`, {files} Dateien, gepinnt in `repos.tsv`). "
                "Pruefen: `bin/alias-check --local` (Baum) bzw. `bin/alias-check` "
                "(gegen den Remote).".format(repo=a["repo"], sha=a["tree_sha256"],
                                             files=a["files"])
                for a in entry["aliases"]) + "\n"
        if status == "referenz":
            banner = "> **Referenzkarte — kein Betrieb auf dieser Maschine.** %s\n\n" % status_reason
        elif status == "bibliothek":
            banner = "> **Bibliothek — kein eigenes CLI.** %s\n\n" % status_reason
        elif status == "binary-fehlt":
            banner = "> **Werkzeug fehlt.** %s\n\n" % status_reason
        elif status == "unklassifiziert":
            banner = "> **Unklassifiziert.** %s\n\n" % status_reason
        else:
            banner = ""
        if status == "bibliothek":
            cmd = ("kein CLI — als Modul einbinden; Import-Test (ob er gelingt, misst "
                   "`bin/doctor`): `NODE_PATH=$(npm root -g) node -e \"require('%s')\"`"
                   % LIB[slug][1])
        elif status == "referenz" and cls != "DK":
            cmd = "kein Kommando — %s%s" % (
                status_reason,
                "" if cls in ("DOC", "DATA") else "; Quelle: `%s`" % entry["vendor"])
        else:
            cmd = cmds[cls]
        if status == "referenz" and cls == "DK":
            why = ("keine Ausgabe — auf dieser Maschine nicht lauffaehig; Rezept in "
                   "`recipes/%s.sh`." % slug)
        elif status == "referenz":
            why = ("keine Ausgabe — laeuft hier nicht; Nutzen ist %s."
                   % ("das Wissen/der Korpus" if cls in ("DOC", "DATA")
                      else "der Quellbaum im vendor-Baum"))
        elif status == "bibliothek":
            why = "keine Ausgabe — die Bibliothek wird aus eigenem Code aufgerufen."
        else:
            why = interpretation[cls]
        body = f"""---
name: {slug}
kind: {kind}
class: {cls}
layer: {layer}
repo: {repo}
install: {json.dumps(INSTALL[cls])}
triggers: [{", ".join(trig[:12])}]
pairs_with: [{", ".join(pairs)}]
---

# {slug} — {role}

**Repo:** `{repo}` · **Layer:** {layer} · **Klasse:** {cls} · **Bezogen:** {"ja" if installed else "nein"}{f" (branch `{meta.get('branch')}`, Lizenz {meta.get('license')})" if installed else ""}

{banner}## Zweck
{role}.

## Wann anwenden
{LAYER_WHEN[layer]}.

## Kommando
{cmd}

## Deutung der Ausgabe
{why}

## Blinde Flecken
- {CLASS_BLIND[cls]}
- {LAYER_BLIND[layer]}

## Kombination (pairs_with)
Zusammen mit: {", ".join("`"+p+"`" for p in pairs) if pairs else "—"}.
Nach diesem Skill weiter mit Layer {NEXT[layer]}.
{("\n## Lokaler Zustand\n" + LOCAL_STATE[slug] + "\n") if slug in LOCAL_STATE else ""}
{alias_block}"""
        open(os.path.join(d, "SKILL.md"), "w").write(body.rstrip("\n") + "\n\n")
        cards += 1

    # --- MANIFEST.yaml ---
    lines = [f"# generiert von bin/gen_skills — {time.strftime('%Y-%m-%dT%H:%M:%S')}",
             f"home: {json.dumps(ROOT)}", f"count: {len(entries)}", "skills:"]
    for e in entries:
        lines.append(f"  - slug: {json.dumps(e['slug'])}")
        for k in ("org", "repo", "class", "kind", "layer", "install", "vendor"):
            lines.append(f"    {k}: {json.dumps(e[k])}")
        lines.append(f"    status: {json.dumps(e['status'])}")
        lines.append(f"    status_reason: {json.dumps(e['status_reason'])}")
        lines.append(f"    fetched: {'true' if e['fetched'] else 'false'}")
        for k in ("branch", "license", "pushed_at"):
            lines.append(f"    {k}: {json.dumps(e[k])}")
        lines.append(f"    archived: {'true' if e['archived'] else ('false' if e['archived'] is False else 'null')}")
        lines.append(f"    bytes: {e['bytes'] or 0}")
        lines.append(f"    role: {json.dumps(e['role'])}")
        if e.get("aliases"):
            lines.append("    aliases:")
            for a in e["aliases"]:
                lines.append(f"      - slug: {json.dumps(a['slug'])}")
                lines.append(f"        repo: {json.dumps(a['repo'])}")
                lines.append(f"        tree_sha256: {json.dumps(a['tree_sha256'])}")
                lines.append(f"        files: {a['files']}")
        lines.append("    triggers:")
        lines.extend(yaml_list(e["triggers"][:12], 6).rstrip("\n").split("\n"))
        lines.append("    pairs_with:")
        lines.extend(yaml_list(e["pairs_with"], 6).rstrip("\n").split("\n"))
        lines.append("    blind_spots:")
        lines.extend(yaml_list(e["blind_spots"], 6).rstrip("\n").split("\n"))
    open(os.path.join(ROOT, "MANIFEST.yaml"), "w").write("\n".join(lines) + "\n")
    json.dump({"generated_at": time.strftime("%Y-%m-%dT%H:%M:%S"), "home": ROOT,
               "count": len(entries), "skills": entries},
              open(os.path.join(ROOT, "manifest.json"), "w"), indent=1, ensure_ascii=False)

    # --- INDEX.md ---
    by_layer = {}
    for e in entries:
        by_layer.setdefault(e["layer"], []).append(e)
    out = ["# Skill-Index", "",
           f"{len(entries)} Skills · generiert {time.strftime('%Y-%m-%d %H:%M')} · Home `{ROOT}`", "",
           "Abruf: `skill list` · `skill show <slug>` · `skill find <wort>` · `skill plan <ziel>`", ""]
    for layer in sorted(by_layer):
        out.append(f"## {layer} — {LAYER_WHEN[layer]}")
        out.append("")
        out.append("| Slug | Kind | Status | Rolle | Bezogen |")
        out.append("|---|---|---|---|---|")
        for e in sorted(by_layer[layer], key=lambda x: x["slug"]):
            alias = (" · Alias: " + ", ".join(a["slug"] for a in e["aliases"])
                     if e.get("aliases") else "")
            out.append(f"| `{e['slug']}` | {e['kind']} | {e['status']} | "
                       f"{e['role']}{alias} | {'ja' if e['fetched'] else '**nein**'} |")
        out.append("")
    open(os.path.join(ROOT, "INDEX.md"), "w").write("\n".join(out) + "\n")
    missing = [e["slug"] for e in entries if not e["fetched"]]
    print(f"cards={cards} manifest={len(entries)} aliases={len(aliases)} missing={len(missing)}")
    if missing:
        print("MISSING: " + ", ".join(missing))


if __name__ == "__main__":
    main()
